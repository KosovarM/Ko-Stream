# Example EnvironmentFile for systemd (`/etc/kostream.env`).
# Copy from repo `.env.example`, fill secrets, chmod 600.
#
#   sudo install -m 600 /home/kosovar/Ko-Stream/.env.example /etc/kostream.env
#   sudo nano /etc/kostream.env

KOSTREAM_ANIME_ROOT=/media/kosovar/PiVault/Media/Ko-Stream/anime
KOSTREAM_MANGA_ROOT=/media/kosovar/PiVault/Media/Ko-Stream/manga
KOSTREAM_SECRET_KEY=replace-with-long-random-string
KOSTREAM_SESSION_SECURE=1
KOSTREAM_TRUST_PROXY=1

MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Must match MyAnimeList API app redirect URI exactly:
MAL_REDIRECT_URI=https://kostream.example.com/auth/mal/callback
