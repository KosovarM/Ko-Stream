# Ko-Stream environment (copy to `.env` on the host or set via systemd EnvironmentFile).
# Never commit real secrets. On the Raspberry Pi you usually export these in the
# service unit or `source` a file under `/etc/kostream.env` — not checked into git.
#
# Live Pi host inventory (paths / SSH): Obsidian
#   70 Documentation/How-to/Raspberry Pi — Host inventory.md
# Public HTTPS (WAN): docs/PUBLIC_HTTPS.md + deploy/

# --- Required for MAL connect / sync ---
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# LAN default: http://127.0.0.1:5001/auth/mal/callback
# Public HTTPS (must match MAL apiconfig exactly):
# MAL_REDIRECT_URI=https://kostream.example.com/auth/mal/callback

# --- Flask session ---
# Strong random string required on the Pi / any shared host.
KOSTREAM_SECRET_KEY=
# FLASK_SECRET_KEY=   # alias accepted by some setups

# --- Media roots ---
# Windows defaults (when env unset): D:\Media\Ko-Stream\anime|manga
# Raspberry Pi (USB PiVault — canonical, from host inventory):
KOSTREAM_ANIME_ROOT=/media/kosovar/PiVault/Media/Ko-Stream/anime
KOSTREAM_MANGA_ROOT=/media/kosovar/PiVault/Media/Ko-Stream/manga
# KOSTREAM_MEDIA_ROOT=   # optional alias for anime root only
# Thumbnails default to sibling …/Ko-Stream/Thumbnail when anime root is set.
# KOSTREAM_THUMBNAIL_ROOT=/media/kosovar/PiVault/Media/Ko-Stream/Thumbnail

# --- LAN vs public HTTPS ---
# Plain HTTP on home Wi-Fi:
# KOSTREAM_SESSION_SECURE=0
# KOSTREAM_TRUST_PROXY=0
#
# Behind Caddy with public HTTPS (required for WAN):
# KOSTREAM_SESSION_SECURE=1
# KOSTREAM_TRUST_PROXY=1

# --- Optional ---
# KOSTREAM_CSRF=1
# KOSTREAM_MAL_HTML_SCRAPE=0
# KOSTREAM_GRAB=0
# KOSTREAM_GRAB_DEMO=0
# KOSTREAM_GRAB_CMD=
# KOSTREAM_GRAB_DIR=
# KOSTREAM_GRAB_CACHE_TTL=
# JELLYFIN_URL=
# JELLYFIN_API_KEY=

# Sunday 08:00 local weekly sync (animes?mangas?titles?chapters?AniSkip). Disable: KOSTREAM_WEEKLY_SYNC=0
# KOSTREAM_WEEKLY_SYNC=1

